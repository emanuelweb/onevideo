DOMAIN=onevideo.example.com
PUBLIC_IP=203.0.113.10            # IP pública del VPS (para ICE de WebRTC)
POSTGRES_USER=onevideo
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=onevideo
DATABASE_URL=postgresql+psycopg://onevideo:cambiame@db:5432/onevideo
SECRET_KEY=cambiame-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://app.onevideo.example.com
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_AUTH_SECRET=cambiame-secreto-interno   # secreto compartido MediaMTX -> API (hook interno de auth)
STREAM_PUBLIC_URL=https://stream.onevideo.example.com
# Directorio de grabaciones dentro del contenedor api (volumen recordings-data,
# compartido con mediamtx). Si se cambia, hay que cambiar también recordPath en
# infra/mediamtx.yml y los montajes de docker-compose.yml. Default: /recordings
RECORDINGS_DIR=/recordings
# Bootstrap del panel de administración. Hacen falta LAS DOS variables:
#   - SUPERADMIN_EMAILS: correos (separados por comas) habilitados para el bootstrap.
#   - SUPERADMIN_BOOTSTRAP_TOKEN: secreto que además hay que enviar en el campo
#     `bootstrap_token` del cuerpo de /auth/register o /auth/login, una sola vez.
# El secreto es imprescindible: el correo del dueño suele ser público, así que sin él
# cualquiera que se adelante a registrarlo quedaría como administrador. Con el token
# vacío el autoservicio queda apagado y solo funciona `scripts/manage.py promote`.
SUPERADMIN_EMAILS=
SUPERADMIN_BOOTSTRAP_TOKEN=
VITE_API_URL=https://api.onevideo.example.com
VITE_STREAM_URL=https://stream.onevideo.example.com
